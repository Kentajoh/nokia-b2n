# Minimal config required to boot Ubuntu Touch.
# This fragment is merged with the LineageOS B2N defconfig.
# It belongs in the kernel tree at arch/arm64/configs/halium.config.
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_QCA_CLD_WLAN=y
