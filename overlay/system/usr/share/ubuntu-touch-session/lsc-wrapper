#!/bin/sh

LSC_FLAGS="--enable-num-framebuffers-quirk=true --disable-overlays=false"
if [ -d /etc/default/lsc-wrapper.d ]
then
    for f in /etc/default/lsc-wrapper.d/*
    do
        . "${f}"
    done
fi

. /etc/environment
export ANDROID_ROOT
export MIR_SERVER_ENABLE_MIRCLIENT=1

case $(systemd-detect-virt --vm) in
qemu|kvm)
    export MIR_MESA_KMS_DISABLE_MODESET_PROBE=1
esac

export LD_PRELOAD="/usr/lib/aarch64-linux-gnu/libb2n-abort.so /usr/lib/aarch64-linux-gnu/libtls-padding.so"
export HYBRIS_LD_LIBRARY_PATH="/vendor/lib64/egl:/vendor/lib64:/system/lib64"
export XDG_RUNTIME_DIR=/run
export WAYLAND_DISPLAY=wayland-syscomp
echo "<3>b2n: lsc preload abort+padding" > /dev/kmsg

# Pass the Android plugin on the compositor command line only. LightDM copies
# compositor MIR_SERVER_* into the user session; if these stay in the
# environment, nested Lomiri loads HWC and aborts.
unset MIR_SERVER_PLATFORM_PATH
unset MIR_SERVER_PLATFORM_GRAPHICS_LIB

/usr/sbin/lomiri-system-compositor \
    $LSC_FLAGS \
    --console-provider=vt \
    --spinner=/usr/bin/lomiri-system-compositor-spinner \
    --platform-path=/usr/lib/aarch64-linux-gnu/mir1/server-platform \
    --platform-graphics-lib=/usr/lib/aarch64-linux-gnu/b2n/mir-android/graphics-android2.so.16 \
    "$@"
status=$?
echo "<3>b2n: compositor exit $status" > /dev/kmsg
exit $status
