deviceinfo_name="Nokia 7 plus"
deviceinfo_manufacturer="HMD Global"
deviceinfo_codename="B2N"
deviceinfo_arch="aarch64"
# The Halium scripts turn aarch64 into ARCH=arm64 and into the
# aarch64-linux-android- toolchain prefix. arm64 would look for a
# compiler that the downloaded GCC does not provide.
deviceinfo_kernel_arch="aarch64"

# Stock vendor on this port is Android 10 (00WW_4_15N, security patch 2021-03-01).
deviceinfo_halium_version="10"
deviceinfo_ubuntu_touch_release="24.04-2.x"

deviceinfo_kernel_source="https://github.com/Kentajoh/nokia-b2n.git"
deviceinfo_kernel_source_branch="halium-10"
deviceinfo_kernel_defconfig="vendor/sdm660-perf_defconfig vendor/nokia/nokia.config vendor/nokia/B2N.config halium.config"
deviceinfo_kernel_clang_compile="true"
deviceinfo_kernel_image_name="Image.gz-dtb"

# Taken from the installed boot_a image: header version 0, page size 4096,
# kernel 0x8000, ramdisk 0x01000000, second 0x00f00000, tags 0x100.
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_bootimg_header_version="0"
deviceinfo_bootimg_os_version="10.0.0"
deviceinfo_bootimg_os_patch_level="2021-03"
deviceinfo_bootimg_partition_size="67108864"
deviceinfo_bootimg_qcdt="false"
deviceinfo_bootimg_append_vbmeta="false"
deviceinfo_use_overlaystore="true"

# The system slot is 3072 MiB. 3000M leaves room for the image to be flashed.
deviceinfo_system_partition_size="3000M"
deviceinfo_rootfs_image_sector_size="4096"

# There is no super partition. The Halium initramfs appends the bootloader
# slot suffix, so system becomes system_b. The boot header command line is
# 512 bytes, so the scheduler and debug tokens from stock are omitted here.
# The ramoops sizes match the region recovery already reads: 2 MiB at
# 0xacb00000 with a 256 KiB console. This build is the kernel that logged
# the VT oops, plus a pmsg stamp at the first instruction. The console
# writer replaces the console zone, so the entry marker is the separate
# pmsg record at 0xaccff000. panic=0 leaves the boot frozen long enough
# to enter Download mode and copy both records.
deviceinfo_kernel_cmdline="console=tty0 console=ttyMSM0,115200,n8 androidboot.console=ttyMSM0 earlycon=msm_serial_dm,0xc170000 androidboot.hardware=qcom androidboot.usbcontroller=a800000.dwc3 systempart=/dev/disk/by-partlabel/system systemd.unified_cgroup_hierarchy=0 panic=0 ramoops.mem_address=0xacb00000 ramoops.mem_size=0x200000 ramoops.console_size=0x40000 ramoops.record_size=0x1000 ramoops.ftrace_size=0x1000 ramoops.pmsg_size=0x1000"
